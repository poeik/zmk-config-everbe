#include "keys_ch.h"
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

// Layer ids. WIN must match CONFIG_ZMK_OS_LAYER_WIN_LAYER (Kconfig).
#define BASE      0
#define LOWER     1
#define UPPER     2
#define WIN       3
#define LOWER_WIN 4
#define UPPER_WIN 5

// Defines what key goes where
// &kp = keypress
// &mo = momentary layer, means it activates a specific layer when we hold down this key
//    &mo 1 = selects into the next layer
// &bt = selects a different bluetooth device
/ {
    combos {
        compatible = "zmk,combos";
        l_combo_lalt{
            timeout-ms = <50>;
            key-positions = <15 29>;
            bindings = <&kp LALT>;
        };
        l_combo_lgui {
            timeout-ms = <50>;
            key-positions = <16 30>;
            bindings = <&kp LGUI>;
        };
        l_combo_lctrl {
            timeout-ms = <50>;
            key-positions = <17 31>;
            bindings = <&kp LCTRL>;
        };

        r_combo_rctrl {
            timeout-ms = <50>;
            key-positions = <20 34>;
            bindings = <&kp RCTRL>;
        };
        r_combo_rgui{
            timeout-ms = <50>;
            key-positions = <21 35>;
            bindings = <&kp RGUI>;
        };
        r_combo_ralt {
            timeout-ms = <50>;
            key-positions = <22 36>;
            bindings = <&kp RALT>;
        };
    };
};
/ {
      behaviors {
          hm: mod_taps {
              compatible = "zmk,behavior-hold-tap";
              #binding-cells = <2>;
              tapping-term-ms = <150>;
              quick-tap-ms = <0>;
              flavor = "tap-preferred";
              bindings = <&kp>, <&kp>;               
          };
          fm: mod_taps2 { // fast homerow mods
              compatible = "zmk,behavior-hold-tap";
              #binding-cells = <2>;
              tapping-term-ms = <125>;
              quick-tap-ms = <0>;
              flavor = "tap-preferred";
              bindings = <&kp>, <&kp>;               
          };
          // Windows: left Ctrl + number -> Win + number.
          // Used on the Upper numpad. Only left Ctrl (Esc-key hold) triggers it, so
          // right Ctrl (combo) + number still sends Ctrl+number.
#define WIN_NUM(label, key)                                   \
          label: label {                                      \
              compatible = "zmk,behavior-mod-morph";          \
              #binding-cells = <0>;                           \
              bindings = <&kp key>, <&kp LG(key)>;            \
              mods = <(MOD_LCTL)>;                            \
          };
          WIN_NUM(wn1, N1) WIN_NUM(wn2, N2) WIN_NUM(wn3, N3) WIN_NUM(wn4, N4) WIN_NUM(wn5, N5)
          WIN_NUM(wn6, N6) WIN_NUM(wn7, N7) WIN_NUM(wn8, N8) WIN_NUM(wn9, N9) WIN_NUM(wn0, N0)
          mk: mom_key {
              compatible = "zmk,behavior-hold-tap";
              #binding-cells = <2>;
              tapping-term-ms = <175>;
              quick-tap-ms = <0>;
              flavor = "balanced";
              bindings = <&mo>, <&kp>;               
          };
      };

      keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Base";
            bindings = <
       &studio_unlock   &kp N1   &kp N2      &kp N3      &kp N4      &kp N5        &kp N6      &kp N7      &kp N8      &kp N9       &kp N0      &kp CH_QUOT
&none  &kp TAB          &kp Q    &kp W       &kp E       &kp R       &kp T         &kp CH_Z    &kp U       &kp I       &kp O        &kp P       &kp BSPC    &none
&bootloader  &hm LCTRL ESC    &kp A    &kp S       &kp D       &kp F       &kp G         &kp H       &kp J       &kp K       &kp L        &kp CH_DIAE &kp CH_DLR  &bootloader
&none  &kp LSHIFT       &kp CH_Y &kp X       &kp C       &kp V       &kp B         &kp N       &kp M       &kp COMMA   &kp DOT      &kp CH_MINS &kp RSHIFT  &none
       &none            &none    &none                   &mk UPPER ENTER &kp LGUI  &kp LALT    &mk LOWER SPACE         &none        &none       &none
            >;
        };
        lower_layer {
            display-name = "Lower";
            bindings = <
       &trans  &trans       &trans      &trans      &trans       &trans             &trans     &trans          &trans       &trans      &trans     &bt BT_CLR_ALL
&trans &trans  &bt BT_SEL 0 &kp F7      &kp F8      &kp F9       &kp F10            &kp C_PREV &kp C_VOL_DN    &kp C_VOL_UP &kp C_NEXT  &kp C_PP   &kp BSPC  &trans
&trans &trans  &bt BT_SEL 1 &kp F4      &kp F5      &kp F6       &kp F11            &kp LEFT   &kp DOWN        &kp UP       &kp RIGHT   &kp C_MUTE &kp DEL   &trans
&trans &trans  &bt BT_CLR   &kp F1      &kp F2      &kp F3       &kp F12            &kp CH_SHOT_FULL &kp CH_SHOT_AREA &kp N5 &trans   &trans     &trans    &trans
       &none   &none        &none                   &kp ENTER    &kp LGUI           &kp RALT   &kp SPACE                    &none       &none      &none
            >;
        };
        upper_layer {
            display-name = "Upper";
            bindings = <
        &trans &trans &trans  &trans      &trans &trans                           &trans      &trans        &trans        &trans       &trans      &trans
&trans  &trans &trans &kp N7  &kp N8      &kp N9 &kp N0                           &kp CH_SLSH &kp CH_LBRC   &kp CH_RBRC   &kp CH_EQ    &kp CH_CIRC &trans  &trans
&trans  &trans &trans &kp N4  &kp N5      &kp N6 &kp CH_SHOT_AREA                 &kp CH_PIPE &kp CH_LPRN   &kp CH_RPRN   &kp CH_LABK  &kp CH_RABK &kp DEL &trans
&trans  &trans &trans &kp N1  &kp N2      &kp N3 &kp CH_SHOT_FULL                 &kp CH_BSLS &kp CH_LCBR   &kp CH_RCBR   &kp CH_HASH  &kp CH_AMPS &trans  &trans
        &none  &none  &none               &kp ENTER &kp LGUI                      &kp RALT    &kp SPACE                   &none        &none       &none
            >;
        };

        // Switched on by src/os_layer.c while the Windows BLE profile is active.
        // Its id must match CONFIG_ZMK_OS_LAYER_WIN_LAYER.
        // All transparent: it only marks "host is Windows" for the conditional layers.
        win_layer {
            display-name = "Win";
            bindings = <
        &trans &trans &trans &trans &trans &trans    &trans &trans &trans &trans &trans &trans
&trans  &trans &trans &trans &trans &trans &trans    &trans &trans &trans &trans &trans &trans &trans
&trans  &trans &trans &trans &trans &trans &trans    &trans &trans &trans &trans &trans &trans &trans
&trans  &trans &trans &trans &trans &trans &trans    &trans &trans &trans &trans &trans &trans &trans
        &trans &trans &trans        &trans &trans    &trans &trans        &trans &trans &trans
            >;
        };
        // Active while Win + Lower: only the keys that differ on Windows.
        lower_win_layer {
            display-name = "Lower Win";
            bindings = <
        &trans &trans &trans &trans &trans &trans    &trans &trans &trans &trans &trans &trans
&trans  &trans &trans &trans &trans &trans &trans    &trans &trans &trans &trans &trans &trans &trans
&trans  &trans &trans &trans &trans &trans &trans    &trans &trans &trans &trans &trans &trans &trans
&trans  &trans &trans &trans &trans &trans &trans    &kp CHW_SHOT_FULL &kp CHW_SHOT_AREA &trans &trans &trans &trans &trans
        &trans &trans &trans        &trans &trans    &trans &trans        &trans &trans &trans
            >;
        };
        // Active while Win + Upper: AltGr symbols of the Windows Swiss German layout,
        // and numpad with Ctrl+<num> -> Win+<num> (activate taskbar app).
        upper_win_layer {
            display-name = "Upper Win";
            bindings = <
        &trans &trans &trans &trans &trans &trans                &trans        &trans        &trans        &trans        &trans &trans
&trans  &trans &trans &wn7   &wn8   &wn9   &wn0                  &trans        &kp CHW_LBRC  &kp CHW_RBRC  &trans        &trans &trans &trans
&trans  &trans &trans &wn4   &wn5   &wn6   &kp CHW_SHOT_AREA     &kp CHW_PIPE  &trans        &trans        &kp CHW_LABK  &kp CHW_RABK &trans &trans
&trans  &trans &trans &wn1   &wn2   &wn3   &kp CHW_SHOT_FULL     &kp CHW_BSLS  &kp CHW_LCBR  &kp CHW_RCBR  &kp CHW_HASH  &trans &trans &trans
        &trans &trans &trans        &trans &trans                &trans        &trans                      &trans        &trans &trans
            >;
        };

        extra1 {
            status = "reserved";
        };
        extra2 {
            status = "reserved";
        };
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";
        win_lower {
            if-layers = <WIN LOWER>;
            then-layer = <LOWER_WIN>;
        };
        win_upper {
            if-layers = <WIN UPPER>;
            then-layer = <UPPER_WIN>;
        };
    };
};

